# ── Supabase (Project Settings -> API) ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=          # publishable / anon key (safe in the browser)
SUPABASE_SERVICE_ROLE_KEY=              # secret: server only, never NEXT_PUBLIC_
DEFAULT_ORGANIZATION_ID=                # optional; defaults to the first organisation

# ── Beds24 (API V2) ─────────────────────────────────────────────────────────
# One of these. A refresh token comes from an invite code
# (https://beds24.com/control3.php?pagetype=apiv2, scopes: bookings,
# bookings-personal, properties) and stays valid while used every 30 days.
BEDS24_REFRESH_TOKEN=
BEDS24_LONG_LIFE_TOKEN=

# ── Shared secrets (make each one long and random) ──────────────────────────
SYNC_SECRET=                            # n8n schedule sends this as header x-sync-secret
BEDS24_WEBHOOK_KEY=                     # goes in the Beds24 webhook URL as ?key=

# ── AI triage + alerts ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=                      # Claude API key (console.anthropic.com); AI is off when empty
APP_URL=                                # e.g. https://inbox.example.com, used for links in alert emails
ALERT_WAIT_MINUTES=15                   # alert when a guest has had no reply for this long
